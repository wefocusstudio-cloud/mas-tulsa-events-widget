# Full JSON content from the Google Cloud Service Account key.
# Do not commit real credentials. Configure the real value in Netlify.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Defaults to the Mas Tulsa calendar configured in the function.
GOOGLE_CALENDAR_ID=50cc82acbe3cd97d12d3a1968ed61b223a64e72731d15e8f517eeb9e913059da@group.calendar.google.com

# Optional. Defaults to the definitive Mas Tulsà reservations spreadsheet.
GOOGLE_SPREADSHEET_ID=10evhMiBahDahEiR1jZJ1N3zgLey-7txLPN2z8oT_eVc

# Required only to invoke the POST-only manual synchronization endpoint.
# Use a long random secret and send it as: Authorization: Bearer <value>
SYNC_EVENTS_TOKEN=
